generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Prisma 7 emits ESM by default; Nest 11 is CJS. Revisit at Nest 12's ESM release.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Control-plane tables only (AD-1): operator identity and the control-plane
// audit trail. Tenant-owned tables (all carrying tenant_id + RLS, AD-5) arrive
// with the stories that need them.

model OperatorUser {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("operator_users")
}

// Append-only (AD-6, AD-8): rows are inserted, never updated or deleted.
model ControlPlaneAuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  action     String
  reason     String?
  // Dual timestamps: when it happened per the app, when the row landed.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("control_plane_audit_events")
}

// The registry owns existence, not state (AD-9): tenant id, region pointer,
// lifecycle - nothing else. Business state lives in the region tenant row.
model TenantRegistryEntry {
  tenantId  String          @id @map("tenant_id") @db.Uuid
  region    String
  lifecycle TenantLifecycle
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_registry")
}

enum TenantLifecycle {
  provisioning
  active
  deleted
}

// An operator's in-flight onboarding wizard. A draft is not a tenant: it is
// control-plane working state, one per operator, deleted on successful submit.
model OnboardingDraft {
  id         String   @id @default(uuid(7)) @db.Uuid
  operatorId String   @unique @map("operator_id") @db.Uuid
  steps      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("onboarding_drafts")
}

// AD-7: the idempotent replay ledger. Lives in the control plane (no
// tenant_id) - a client op_id lands here once, and a replay of an applied op
// is a ledger hit, never a second effect. Story 7 (DLQ replay) is its main
// consumer; created now because AD-7 binds CAP-4 too.
model AppliedOp {
  opId      String   @id @map("op_id") @db.Uuid
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("applied_ops")
}

// ---------------------------------------------------------------------------
// Region-plane tables (v1: the single Mumbai plane shares this database).
// Every tenant-owned table carries tenant_id with forced RLS (AD-5) - the
// policies live in the migration SQL. `tenants.id` IS the tenant_id.
// ---------------------------------------------------------------------------

enum TenantStatus {
  provisioning
  active
}

enum Country {
  IN
  AU
}

enum SubscriptionPlan {
  standard
  enterprise
}

enum BillingPeriod {
  monthly
  annual
}

model Tenant {
  id                String           @id @db.Uuid
  name              String
  registeredAddress String           @map("registered_address")
  contactName       String           @map("contact_name")
  contactEmail      String           @map("contact_email")
  contactPhone      String           @map("contact_phone")
  country           Country
  status            TenantStatus     @default(provisioning)
  // Subscription business state is region-side per AD-9; a later story
  // normalizes it into per-outlet subscriptions.
  plan              SubscriptionPlan
  billingPeriod     BillingPeriod    @map("billing_period")
  // Flat map of design-token overrides (logo URL, accent color, ...) applied
  // to the tenant's guest-facing surfaces.
  brandingTokens    Json             @default("{}") @map("branding_tokens")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  taxRegistrations    TenantTaxRegistration[]
  brands              Brand[]
  outlets             Outlet[]
  roles               Role[]
  menuCategories      MenuCategory[]
  menuItems           MenuItem[]
  itemVariants        ItemVariant[]
  itemPrices          ItemPrice[]
  modifierGroups      ModifierGroup[]
  modifiers           Modifier[]
  itemModifierGroups  ItemModifierGroup[]
  allergens           Allergen[]
  itemAllergens       ItemAllergen[]
  combos              Combo[]
  comboComponents     ComboComponent[]
  itemOutletOverrides ItemOutletOverride[]
  menuImportDrafts    MenuImportDraft[]
  ownerInvites        OwnerInvite[]
  ownerUsers          OwnerUser[]
  capabilities        TenantCapability[]
  outletCapabilities  OutletCapability[]
  devices             Device[]
  enrolmentCodes      EnrolmentCode[]
  deadLetters         SyncDeadLetter[]
  subscription        Subscription?
  invoices            Invoice[]
  checklistProgress   ChecklistProgress?
  floors              Floor[]
  diningTables        DiningTable[]
  stations            Station[]
  printers            Printer[]
  staffUsers          StaffUser[]
  clockEvents         ClockEvent[]
  orders              Order[]
  orderLines          OrderLine[]
  orderLineModifiers  OrderLineModifier[]
  shifts              Shift[]
  cashMovements       CashMovement[]
  bills               Bill[]
  tenders             Tender[]
  billNumberCounters  BillNumberCounter[]
  creditNotes         CreditNote[]
  creditNoteLines     CreditNoteLine[]
  tokenNumberCounters TokenNumberCounter[]

  // The directory list is served from these: filter columns plus the
  // created_at ordering the default sort and cursor walk.
  @@index([createdAt])
  @@index([status])
  @@index([country])
  @@map("tenants")
}

// Tenant-level feature switches operated from the console. Absent row = the
// platform default for that key; a row records an explicit operator choice.
model TenantCapability {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_capabilities")
}

enum TaxRegistrationType {
  gstin
  abn
}

model TenantTaxRegistration {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  registrationType   TaxRegistrationType @map("registration_type")
  // One legal entity, one tenant per region - also the forced-failure anchor
  // for the atomicity tests.
  registrationNumber String              @unique @map("registration_number")
  legalEntityName    String              @map("legal_entity_name")
  taxProfile         String              @map("tax_profile")
  fssaiLicense       String?             @map("fssai_license")
  compositionScheme  Boolean             @default(false) @map("composition_scheme")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_tax_registrations")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  outlets Outlet[]

  @@map("brands")
}

enum OutletType {
  dine_in
  qsr
  cloud_kitchen
  food_court
}

model Outlet {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  brandId   String     @map("brand_id") @db.Uuid
  name      String
  address   String
  type      OutletType
  timezone  String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  brand               Brand                @relation(fields: [brandId], references: [id])
  devices             Device[]
  enrolmentCodes      EnrolmentCode[]
  itemPrices          ItemPrice[]
  itemOutletOverrides ItemOutletOverride[]
  capabilities        OutletCapability[]
  floors              Floor[]
  stations            Station[]
  printers            Printer[]
  clockEvents         ClockEvent[]
  orders              Order[]
  shifts              Shift[]
  bills               Bill[]
  billNumberCounter   BillNumberCounter?
  tokenNumberCounter  TokenNumberCounter?

  @@index([tenantId])
  @@map("outlets")
}

// CAP-10: per-outlet feature switches (QR ordering, kiosk, token queue, ...),
// driven by restaurant type. Distinct from TenantCapability (tenant-wide,
// operator-set from Platform Console) - this one is outlet-scoped and owner-
// set from Tenant Admin. Absent row = disabled by default.
model OutletCapability {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  key       String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([outletId, key])
  @@index([tenantId])
  @@map("outlet_capabilities")
}

// isManager (CAP-8/AD-15): the flag platform/manager-auth checks to decide
// whether a StaffUser can approve a gated action - a role property, not a
// hardcoded name check, so a tenant's set of approving roles can change
// without touching manager-auth code. Seeded true for 'Owner' and 'Manager'
// only (tenants.service.ts SYSTEM_ROLES); see manager-auth.service.ts for
// the full reasoning.
model Role {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean @default(false) @map("is_system")
  isManager Boolean @default(false) @map("is_manager")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  staffUsers StaffUser[]

  @@unique([tenantId, name])
  @@map("roles")
}

model MenuCategory {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int    @map("sort_order")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  items  MenuItem[]
  combos Combo[]

  @@map("menu_categories")
}

// AD-11: price lives in item_prices, not here - this table never carries a
// price column so no future writer is tempted to UPDATE one in place.
model MenuItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String
  // Short label for kitchen order tickets (PRD FR-10).
  shortName  String   @map("short_name")
  // The 86 toggle (CAP-4): tenant-wide, immediate, not versioned - price
  // history is the only thing AD-11 requires append-only, not availability.
  available  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  category        MenuCategory         @relation(fields: [categoryId], references: [id])
  variants        ItemVariant[]
  prices          ItemPrice[]
  modifierGroups  ItemModifierGroup[]
  allergens       ItemAllergen[]
  comboComponents ComboComponent[]
  outletOverrides ItemOutletOverride[]
  orderLines      OrderLine[]

  // No two items in the same category may share a name (also the natural
  // forced-failure anchor for the menu-import commit atomicity test).
  @@unique([tenantId, categoryId, name])
  @@map("menu_items")
}

// CAP-4: e.g. Half/Full. A price row with a null variantId prices the item
// itself; a price row with a variantId prices that specific variant - the two
// never mix for the same item once variants exist (enforced at write time).
model ItemVariant {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  name      String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  item       MenuItem    @relation(fields: [itemId], references: [id])
  prices     ItemPrice[]
  orderLines OrderLine[]

  @@unique([itemId, name])
  @@map("item_variants")
}

enum PriceChannel {
  dine_in
  takeaway
  delivery
  qr
  aggregator
}

// AD-11: insert-only, extended by this story (story 2 created it) with the
// dimensions CAP-4 needs. A price change is always a new row - nothing ever
// UPDATEs price_minor. variantId/channel/outletId are each nullable and each
// null means "unscoped on this dimension" (variant: prices the base item;
// channel: applies to every channel; outlet: applies tenant-wide) - the
// current-price read (menu/pricing.ts) picks the most specific match. See
// menu/pricing.ts for the resolution query this shape exists to serve.
model ItemPrice {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  itemId      String        @map("item_id") @db.Uuid
  variantId   String?       @map("variant_id") @db.Uuid
  outletId    String?       @map("outlet_id") @db.Uuid
  channel     PriceChannel?
  // Money as bigint minor units (workspace convention).
  priceMinor  BigInt        @map("price_minor")
  currency    String        @db.Char(3)
  // Null/past = immediate; future = scheduled. Defaults to "now" so an
  // un-scheduled edit is immediately current without any special-casing in
  // the resolution query.
  effectiveAt DateTime      @default(now()) @map("effective_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  item    MenuItem     @relation(fields: [itemId], references: [id])
  variant ItemVariant? @relation(fields: [variantId], references: [id])
  outlet  Outlet?      @relation(fields: [outletId], references: [id])

  @@index([itemId, variantId, effectiveAt])
  @@map("item_prices")
}

// CAP-4 modifier groups (e.g. "Spice Level", "Add-ons") - tenant-scoped and
// reusable across items via item_modifier_groups. min/max are validated at
// write time (0 <= min <= max) in menu/modifier-groups.service.ts.
model ModifierGroup {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  minSelections Int      @map("min_selections")
  maxSelections Int      @map("max_selections")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  modifiers Modifier[]
  items     ItemModifierGroup[]

  @@unique([tenantId, name])
  @@map("modifier_groups")
}

// A modifier's price is a flat add-on, not versioned history (unlike item
// prices) - CAP-4's AD-11 obligation binds item_prices, not this table.
model Modifier {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  groupId    String @map("group_id") @db.Uuid
  name       String
  priceMinor BigInt @default(0) @map("price_minor")
  sortOrder  Int    @map("sort_order")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  group              ModifierGroup       @relation(fields: [groupId], references: [id])
  orderLineModifiers OrderLineModifier[]

  @@unique([groupId, name])
  @@map("modifiers")
}

model ItemModifierGroup {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sortOrder Int    @map("sort_order")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  item   MenuItem      @relation(fields: [itemId], references: [id])
  group  ModifierGroup @relation(fields: [groupId], references: [id])

  @@unique([itemId, groupId])
  @@map("item_modifier_groups")
}

// CAP-4 allergen/dietary tags - moved here from CAP-3 menu import per the
// spec amendment (unreliable from OCR/CSV extraction). Tenant-scoped catalog
// + a join table so the same tag applies to many items.
model Allergen {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  items  ItemAllergen[]

  @@unique([tenantId, name])
  @@map("allergens")
}

model ItemAllergen {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  itemId     String @map("item_id") @db.Uuid
  allergenId String @map("allergen_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  item     MenuItem @relation(fields: [itemId], references: [id])
  allergen Allergen @relation(fields: [allergenId], references: [id])

  @@unique([itemId, allergenId])
  @@map("item_allergens")
}

// CAP-4 combos - a lightweight bundle of existing items at a flat bundle
// price. Not in scope for versioned/scheduled pricing (only item_prices
// carries that AD-11 obligation); a combo price is edited in place like any
// other routine content field.
model Combo {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  name       String
  priceMinor BigInt   @map("price_minor")
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  category   MenuCategory?    @relation(fields: [categoryId], references: [id])
  components ComboComponent[]

  @@unique([tenantId, name])
  @@map("combos")
}

model ComboComponent {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  comboId  String @map("combo_id") @db.Uuid
  itemId   String @map("item_id") @db.Uuid
  quantity Int    @default(1)

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  combo  Combo    @relation(fields: [comboId], references: [id])
  item   MenuItem @relation(fields: [itemId], references: [id])

  @@unique([comboId, itemId])
  @@map("combo_components")
}

// CAP-4 per-outlet availability override - price's per-outlet dimension
// already lives on item_prices.outletId (one insert-only price path, AD-11),
// so this table carries only availability, which is mutable by design (86 is
// immediate, not versioned). No row = the item's tenant-wide `available`
// applies at that outlet.
model ItemOutletOverride {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  available Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  item   MenuItem @relation(fields: [itemId], references: [id])
  outlet Outlet   @relation(fields: [outletId], references: [id])

  @@unique([itemId, outletId])
  @@map("item_outlet_overrides")
}

enum MenuImportStatus {
  draft
  committed
}

// CAP-3: server-held draft between upload and commit (AD-6) - a real row, not
// per-instance memory, so it survives a reload and works across instances.
// `payload` holds the extracted items (name, shortName, category, price,
// per-field confidence); PATCH edits payload in place; commit copies the
// (possibly edited) payload into real catalogue rows, then marks this row
// resolved rather than deleting it, leaving a record of what was imported.
model MenuImportDraft {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  status      MenuImportStatus @default(draft)
  sourceType  String           @map("source_type")
  fileName    String           @map("file_name")
  payload     Json
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  committedAt DateTime?        @map("committed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("menu_import_drafts")
}

model OwnerInvite {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  email     String
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  // Only the hash is stored; the raw token is delivered out of band when the
  // invite email ships (Tenant Admin story).
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  // Distinct from expiry (CAP-1: expired vs. already-used are different
  // rejections) - set once, on the accept that consumes the token.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("owner_invites")
}

// The admin realm's principal (AD-10): one tenant owner account, created on
// invite acceptance. A separate model from OperatorUser by design (AD-3's
// disjoint-realm rule extends to AD-10) - no shared identity table.
model OwnerUser {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@map("owner_users")
}

// CAP-2 go-live checklist: one row per tenant, a completion timestamp per
// step or null for not-yet-done. Stories 2, 5, 6, 7 each own one column and
// call PATCH /admin/v1/checklist/:step when their feature completes it -
// this table does not derive any step from other tables today.
model ChecklistProgress {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  outletDetailsAt DateTime? @map("outlet_details_at") @db.Timestamptz(6)
  floorPlanAt     DateTime? @map("floor_plan_at") @db.Timestamptz(6)
  menuImportAt    DateTime? @map("menu_import_at") @db.Timestamptz(6)
  devicesAt       DateTime? @map("devices_at") @db.Timestamptz(6)
  staffAt         DateTime? @map("staff_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("checklist_progress")
}

// CAP-7 staff & roles: a POS-facing user, distinct from OwnerUser (the admin
// console principal) the same way OperatorUser/OwnerUser are already kept
// apart - staff sign into the POS with a PIN, never the admin console. Role
// is always one of the six system roles Platform Console seeds per tenant
// (tenants.service.ts SYSTEM_ROLES) - no free-text roles in v1, so roleId is
// a required FK rather than a string column, and the FK itself is the
// enforcement that a staff member can only ever hold a role that exists.
// Only the PIN's argon2 hash is stored (never the raw PIN, same posture as
// owner_users.password_hash); pinRevokedAt marks a PIN inactive without
// erasing the issuance history.
model StaffUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  name         String
  email        String?
  pinHash      String?   @map("pin_hash")
  pinIssuedAt  DateTime? @map("pin_issued_at") @db.Timestamptz(6)
  pinRevokedAt DateTime? @map("pin_revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  role              Role           @relation(fields: [roleId], references: [id])
  clockEvents       ClockEvent[]
  orders            Order[]
  orderLinesAdded   OrderLine[]
  shiftsOpened      Shift[]        @relation("ShiftOpenedBy")
  shiftsClosed      Shift[]        @relation("ShiftClosedBy")
  cashMovementsMade CashMovement[]
  billsCreated      Bill[]         @relation("BillCreatedBy")
  billsFinalized    Bill[]         @relation("BillFinalizedBy")
  creditNotesCreated  CreditNote[] @relation("CreditNoteCreatedBy")
  creditNotesApproved CreditNote[] @relation("CreditNoteApprovedBy")

  @@index([tenantId])
  @@map("staff_users")
}

// ---------------------------------------------------------------------------
// pos/CAP-1 PIN login & shift clock (AD-13). Records every clock-in/out for a
// staff member at an outlet - "clock-in once per local day" is enforced by
// reading the latest row, not by a separate flag column (see
// pos/clock/clock.util.ts). Insert-only: a day's attendance is a sequence of
// events, never edited in place.
enum ClockEventType {
  clock_in
  clock_out
}

model ClockEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  staffId    String         @map("staff_id") @db.Uuid
  outletId   String         @map("outlet_id") @db.Uuid
  type       ClockEventType
  occurredAt DateTime       @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  staff  StaffUser @relation(fields: [staffId], references: [id])
  outlet Outlet    @relation(fields: [outletId], references: [id])

  @@index([tenantId])
  @@index([staffId, occurredAt])
  @@map("clock_events")
}

// ---------------------------------------------------------------------------
// CAP-5 floor plan & stations (AD-5). A floor belongs to an outlet; tables
// belong to a floor with an absolute pixel/grid position the editor owns.
// Stations and printers are outlet-scoped siblings of floors, not nested
// under them - a station routes tickets regardless of which floor a table
// sits on. Kept as a direct primaryPrinterId/fallbackPrinterId pair on
// Station rather than a station_printers join table: the design only ever
// needs one primary + one optional fallback per station (see the Kitchen
// Routing panel in the floor-plan-editor screen), so a join table would add
// multiplicity the product doesn't use (ponytail: minimum that works).
// ---------------------------------------------------------------------------

model Floor {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  outletId  String    @map("outlet_id") @db.Uuid
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  outlet Outlet        @relation(fields: [outletId], references: [id])
  tables DiningTable[]

  @@index([tenantId])
  @@index([outletId])
  @@map("floors")
}

enum TableShape {
  circle
  square
  rectangle
}

// Bounds (x, y, width, height) are grid units the editor defines - overlap
// checks compare these directly, no unit conversion in this service.
model DiningTable {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  floorId      String     @map("floor_id") @db.Uuid
  label        String
  x            Int
  y            Int
  width        Int
  height       Int
  shape        TableShape
  seatCapacity Int        @map("seat_capacity")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  floor  Floor   @relation(fields: [floorId], references: [id])
  orders Order[]

  @@index([tenantId])
  @@index([floorId])
  @@map("dining_tables")
}

enum PrinterRenderMode {
  text
  bitmap
}

model Printer {
  id         String            @id @default(uuid(7)) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  outletId   String            @map("outlet_id") @db.Uuid
  name       String
  renderMode PrinterRenderMode @map("render_mode")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz(6)

  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  outlet             Outlet    @relation(fields: [outletId], references: [id])
  stationsAsPrimary  Station[] @relation("StationPrimaryPrinter")
  stationsAsFallback Station[] @relation("StationFallbackPrinter")

  @@unique([outletId, name])
  @@index([tenantId])
  @@map("printers")
}

// noPrinterAcknowledged is not persisted - it is a one-time confirmation the
// request must carry when primaryPrinterId is omitted (SPEC CAP-5 success
// criterion: never silently save an unset printer). A station's actual
// "has no printer" state is simply primaryPrinterId = null.
model Station {
  id                     String    @id @default(uuid(7)) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  outletId               String    @map("outlet_id") @db.Uuid
  name                   String
  ageingThresholdMinutes Int       @map("ageing_threshold_minutes")
  primaryPrinterId       String?   @map("primary_printer_id") @db.Uuid
  fallbackPrinterId      String?   @map("fallback_printer_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  outlet          Outlet   @relation(fields: [outletId], references: [id])
  primaryPrinter  Printer? @relation("StationPrimaryPrinter", fields: [primaryPrinterId], references: [id])
  fallbackPrinter Printer? @relation("StationFallbackPrinter", fields: [fallbackPrinterId], references: [id])

  @@unique([outletId, name])
  @@index([tenantId])
  @@map("stations")
}

// Region-plane audit trail (AD-8): tenant-affecting mutations audit here, in
// the same transaction as the mutation (AD-6). Append-only - the RLS policies
// in the migration grant INSERT and SELECT only.
//
// approverId/approverName (CAP-8/AD-15): populated only for manager-gated
// actions (void-after-fire, comp, discount-above-threshold, price override,
// refund, no-sale drawer-open) - null for every routine AD-6 audit row that
// has no approval step (e.g. staff.role_changed, staff.pin_revoked above).
// approverName, not approverEmail: the approving StaffUser's email is
// optional (see StaffUser.email) but name is required, so name is what's
// guaranteed to identify them. actorEmail already carries the acting
// StaffUser's identity the same way non-pos callers do today.
model AuditEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorEmail   String   @map("actor_email")
  approverId   String?  @map("approver_id") @db.Uuid
  approverName String?  @map("approver_name")
  action       String
  reason       String
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// CAP-4 device fleet and enrolment (AD-6, AD-7).
// ---------------------------------------------------------------------------

enum DeviceType {
  pos
  kds
  kiosk
  cds
}

enum DeviceRole {
  terminal
  hub
}

enum DeviceStatus {
  active
  revoked
}

model Device {
  id                     String       @id @default(uuid(7)) @db.Uuid
  tenantId               String       @map("tenant_id") @db.Uuid
  outletId               String?      @map("outlet_id") @db.Uuid
  label                  String
  type                   DeviceType
  role                   DeviceRole   @default(terminal)
  status                 DeviceStatus @default(active)
  hardwareKeyFingerprint String       @map("hardware_key_fingerprint")
  enrolledAt             DateTime     @map("enrolled_at") @db.Timestamptz(6)
  revokedAt              DateTime?    @map("revoked_at") @db.Timestamptz(6)

  // CAP-6 sync health: latest-heartbeat snapshot, not an event log (NFR-15 -
  // metadata only, there is no payload field to begin with). A device that
  // has never sent a heartbeat has lastContactAt = null; the read side falls
  // back to enrolledAt so a device silent since enrolment still classifies.
  lastContactAt        DateTime? @map("last_contact_at") @db.Timestamptz(6)
  outboxDepth          Int?      @map("outbox_depth")
  appVersion           String?   @map("app_version")
  clockSkewSeconds     Int?      @map("clock_skew_seconds")
  recentRejectionCount Int?      @map("recent_rejection_count")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  outlet      Outlet?          @relation(fields: [outletId], references: [id])
  deadLetters SyncDeadLetter[]

  @@index([tenantId])
  @@index([outletId])
  @@map("devices")
}

// A one-time enrolment ticket (CAP-4): 15-minute TTL, consumed exactly once.
// Only the hash is stored - the raw code is returned once, at generation.
model EnrolmentCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  outletId   String     @map("outlet_id") @db.Uuid
  codeHash   String     @unique @map("code_hash")
  deviceType DeviceType @map("device_type")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?  @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])

  @@index([tenantId])
  @@map("enrolment_codes")
}

// AD-7's never-drop rejection sink - the single table CAP-4 and (later) CAP-7
// both consume. No payload bodies (NFR-15): payloadMeta is metadata only.
model SyncDeadLetter {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  opId        String    @map("op_id") @db.Uuid
  reasonCode  String    @map("reason_code")
  reasonText  String    @map("reason_text")
  payloadMeta Json      @default("{}") @map("payload_meta")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([tenantId])
  @@index([deviceId])
  @@map("sync_dead_letters")
}

// ---------------------------------------------------------------------------
// CAP-5 subscription operations (AD-6, AD-9). Plan and billing period stay on
// Tenant (already there); this table adds the state a subscription actually
// transitions through. AD-9: suspension lives here, in the region plane -
// never duplicated into the control-plane registry.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  active
  arrears
  suspended
}

model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  suspendedAt        DateTime?          @map("suspended_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  invoices Invoice[]

  @@map("subscriptions")
}

enum InvoiceStatus {
  paid
  pending
  overdue
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  period         String
  amountMinor    BigInt        @map("amount_minor_units")
  status         InvoiceStatus @default(pending)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// pos/CAP-2 table map & order ownership (AD-5, AD-6). Reuses the existing
// Floor/DiningTable models from tenant-admin/CAP-5 rather than a second table
// model - this section only adds Order. Order is the first money-path table
// in the ARCHITECTURE-SPINE sense (AD-14 lists it among the greenfield
// pos tables) but AD-14's insert-only-past-finalisation rule binds pos/CAP-6,
// 7, 9, 10 only - not this story. At this base-fields stage (no OrderLine,
// no Bill yet) an Order is an ordinary mutable draft row: status moves
// open -> sent -> closed by plain UPDATE, gated by ownership below, not by
// an insert-only/finalise discipline. tableId is nullable already for a
// later counter-order (CAP-6) story that never sets it.
// ---------------------------------------------------------------------------

enum OrderStatus {
  open
  sent
  closed
}

model Order {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  outletId    String      @map("outlet_id") @db.Uuid
  tableId     String?     @map("table_id") @db.Uuid
  // Exactly one owning staff member at a time (this story's core mechanic) -
  // reassigned only through the explicit transfer action, never implicitly.
  ownerId     String      @map("owner_id") @db.Uuid
  status      OrderStatus @default(open)
  // pos/CAP-6 QSR counter and token mode (AD-14, story 7). Assigned only at
  // creation time for a counter order (tableId null) - see
  // pos/orders/orders.service.ts's createCounterOrder, which reserves the
  // next number from TokenNumberCounter below in the same transaction that
  // creates the Order. Null on every table (dine-in) order. Gapless per
  // (tenant_id, outlet_id), same posture as Bill.billNumber - the unique
  // index below is a plain index, not partial, since Postgres already
  // treats every NULL as distinct from every other NULL.
  tokenNumber Int?        @map("token_number")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  outlet Outlet       @relation(fields: [outletId], references: [id])
  table  DiningTable? @relation(fields: [tableId], references: [id])
  owner  StaffUser    @relation(fields: [ownerId], references: [id])
  lines  OrderLine[]
  bill   Bill?

  @@unique([tenantId, outletId, tokenNumber])
  @@index([tenantId])
  @@index([outletId])
  @@index([tableId])
  @@map("orders")
}

// pos/CAP-3 order lines (AD-14). Built against the real menu catalogue
// (MenuItem/ItemVariant/Modifier from tenant-admin/CAP-4) - itemId/variantId
// point straight at those tables rather than duplicating a shape. Price is
// snapshotted at add-time into unitPriceMinor/OrderLineModifier.priceMinor so
// a later item_prices or modifier price change never retroactively alters an
// in-progress order (same insert-only-snapshot posture as item_prices
// itself, applied one layer up). A line is only ever mutated (quantity,
// modifier re-selection) or removed while its order is still "open" - once
// "sent", pos/orders/orders.service.ts is the sole enforcer since Order
// (not OrderLine) owns the status column.
//
// pos/CAP-4 group ordering (issue #58): seatNumber is nullable at the DB
// level (migration safety - existing rows have none, and CAP-3's own
// add/edit/remove paths never require it), but application-enforced as
// required before an order can move to "sent" - see
// pos/orders/orders.service.ts's updateStatus, the sole enforcer of that
// gate, same posture as the status column itself.
model OrderLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  quantity       Int
  unitPriceMinor BigInt   @map("unit_price_minor")
  seatNumber     Int?     @map("seat_number")
  addedByStaffId String   @map("added_by_staff_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  order        Order               @relation(fields: [orderId], references: [id])
  item         MenuItem            @relation(fields: [itemId], references: [id])
  variant      ItemVariant?        @relation(fields: [variantId], references: [id])
  addedByStaff StaffUser           @relation(fields: [addedByStaffId], references: [id])
  modifiers    OrderLineModifier[]
  // pos/CAP-9 refunds (AD-14): a CreditNoteLine reverses this exact line's
  // unit price/modifiers snapshot, quantity at a time - see CreditNoteLine's
  // own comment for why refunds itemize against OrderLine, not against Bill
  // (Bill carries only whole-bill subtotal/tax aggregates, no lines of its
  // own).
  creditNoteLines CreditNoteLine[]

  @@index([tenantId])
  @@index([orderId])
  @@map("order_lines")
}

// A line's selected modifiers - many-to-many via a join row rather than a
// scalar array so each selection carries its own price snapshot (the same
// per-item add-on can be re-priced later without touching rows already
// added to an order).
model OrderLineModifier {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid
  modifierId  String @map("modifier_id") @db.Uuid
  priceMinor  BigInt @map("price_minor")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([tenantId])
  @@index([orderLineId])
  @@map("order_line_modifiers")
}

// ---------------------------------------------------------------------------
// pos/CAP-10 shift & cash management (AD-14). Greenfield for the whole
// money-path domain alongside Order/Bill (built independently by story 3) -
// see AD-14's table list. Shift and CashMovement are insert-only past
// finalisation: nothing ever UPDATEs a CashMovement row, and a Shift's
// counted/expected/overShort trio is written exactly once, by close(), in
// the same call that sets closedAt (pos/shifts/shifts.service.ts is the only
// writer of those four columns). "One open shift per outlet at a time" is
// enforced two ways: a partial unique index on (outlet_id) WHERE
// closed_at IS NULL (see this table's migration.sql - Prisma's schema DSL
// has no partial-index syntax, same reason RLS policies live in migration
// SQL rather than here) is the actual guarantee under concurrent opens; the
// service also pre-checks for a friendlier 409 message, but the index is
// what a race condition ultimately falls back on.
// ---------------------------------------------------------------------------

model Shift {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  outletId        String    @map("outlet_id") @db.Uuid
  openedByStaffId String    @map("opened_by_staff_id") @db.Uuid
  floatMinor      BigInt    @map("float_minor")
  openedAt        DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedByStaffId String?   @map("closed_by_staff_id") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  // Set together, once, by close() - never independently, and never before
  // countedMinor is supplied by the caller (CAP-10's blind-count rule: the
  // server computes expectedMinor/overShortMinor only inside this same
  // write, so no earlier read of this row can have exposed them).
  countedMinor    BigInt?   @map("counted_minor")
  expectedMinor   BigInt?   @map("expected_minor")
  overShortMinor  BigInt?   @map("over_short_minor")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  outlet        Outlet         @relation(fields: [outletId], references: [id])
  openedByStaff StaffUser      @relation("ShiftOpenedBy", fields: [openedByStaffId], references: [id])
  closedByStaff StaffUser?     @relation("ShiftClosedBy", fields: [closedByStaffId], references: [id])
  cashMovements CashMovement[]

  @@index([tenantId])
  @@index([outletId])
  @@map("shifts")
}

enum CashMovementType {
  paid_out
  bank_drop
}

// A cash movement is logged against the currently open shift only (checked
// in the service, not here); insert-only, like every other money-path row
// under AD-14 - there is no update/delete path for a logged movement.
model CashMovement {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  shiftId          String           @map("shift_id") @db.Uuid
  type             CashMovementType
  amountMinor      BigInt           @map("amount_minor")
  reason           String
  createdByStaffId String           @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  shift          Shift     @relation(fields: [shiftId], references: [id])
  createdByStaff StaffUser @relation(fields: [createdByStaffId], references: [id])

  @@index([tenantId])
  @@index([shiftId])
  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// pos/CAP-7 bill & settle (AD-14). Greenfield alongside Order/Shift/
// CashMovement per AD-14's table list - Bill/Tender/BillNumberCounter are the
// last pieces of that set. A Bill is created "open" from an Order's current
// lines (subtotal/tax snapshotted at that moment, same posture as OrderLine's
// own price snapshot one layer down) and moves open -> finalized exactly
// once - no UPDATE path once finalized (src/pos/bills/bills.service.ts is the
// sole writer, and it always does so via a status='open' compare-and-swap
// UPDATE, never a plain update-by-id, to make a concurrent double-finalise
// race land a 409 instead of corrupting the row - see that file for the
// detail). discountMinor/discountReason are set together or not at all -
// enforced in the service, since Prisma's schema DSL has no cross-column
// CHECK constraint syntax.
enum BillStatus {
  open
  finalized
}

model Bill {
  id                 String     @id @default(uuid(7)) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  outletId           String     @map("outlet_id") @db.Uuid
  orderId            String     @unique @map("order_id") @db.Uuid
  // Assigned only at finalise time, by the reserve-then-commit counter below
  // - null on a still-open Bill. Gapless per (tenant_id, outlet_id), not per
  // device (AD-14: this prototype's sessions aren't device-bound).
  billNumber         Int?       @map("bill_number")
  subtotalMinor      BigInt     @map("subtotal_minor")
  taxMinor           BigInt     @map("tax_minor")
  discountMinor      BigInt?    @map("discount_minor")
  discountReason     String?    @map("discount_reason")
  status             BillStatus @default(open)
  createdByStaffId   String     @map("created_by_staff_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  finalizedByStaffId String?    @map("finalized_by_staff_id") @db.Uuid
  finalizedAt        DateTime?  @map("finalized_at") @db.Timestamptz(6)

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  outlet           Outlet     @relation(fields: [outletId], references: [id])
  order            Order      @relation(fields: [orderId], references: [id])
  createdByStaff   StaffUser  @relation("BillCreatedBy", fields: [createdByStaffId], references: [id])
  finalizedByStaff StaffUser? @relation("BillFinalizedBy", fields: [finalizedByStaffId], references: [id])
  tenders          Tender[]
  creditNotes      CreditNote[]

  // Gapless numbering's uniqueness guarantee. A plain (non-partial) unique
  // index is enough here - Postgres treats every NULL as distinct from every
  // other NULL in a unique index, so any number of still-open Bills
  // (billNumber IS NULL) coexist freely, and only two actually-numbered bills
  // in the same outlet could ever collide.
  @@unique([tenantId, outletId, billNumber])
  @@index([tenantId])
  @@index([outletId])
  @@map("bills")
}

enum TenderMethod {
  cash
  upi_manual
}

// Multiple tenders per bill = split payment (SPEC CAP-7's N-way/amount split,
// structurally: the caller posts however many tender rows the split
// produces). Insert-only, like every other money-path row under AD-14 - no
// UPDATE/DELETE path for a tender once finalise has written it.
model Tender {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  billId      String       @map("bill_id") @db.Uuid
  method      TenderMethod
  amountMinor BigInt       @map("amount_minor")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  bill   Bill   @relation(fields: [billId], references: [id])

  @@index([tenantId])
  @@index([billId])
  @@map("tenders")
}

// The reserve-then-commit counter AD-14 calls for: one row per outlet,
// incremented by a real UPDATE inside the SAME transaction that writes the
// finalized Bill. This is deliberately NOT a Postgres SEQUENCE - nextval() on
// a sequence is non-transactional (it does not roll back with its
// transaction), which is exactly the gap a sequence would introduce on a
// failed/aborted finalise. A plain row updated by a normal UPDATE statement
// participates in the transaction like any other write: if the finalise
// transaction rolls back for any reason, the increment rolls back with it,
// and the next attempt reserves the same number - genuinely gapless, not
// just gapless in the common case.
model BillNumberCounter {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  outletId   String @unique @map("outlet_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])

  @@map("bill_number_counters")
}

// ---------------------------------------------------------------------------
// pos/CAP-9 refunds & adjustments (AD-14, AD-15). The third money-path
// insert-only table after Bill/Tender - nothing here ever UPDATEs a Bill or
// its lines/tenders; a refund is always a new, separate CreditNote linked by
// originalBillId. Gated by platform/manager-auth's 'refund' action
// (src/pos/bills/bills.service.ts's refund()) exactly like discount-above-
// threshold already is.
//
// Itemization note: Bill itself stores only whole-bill aggregates
// (subtotalMinor/taxMinor/discountMinor) - it has no line items of its own
// (see the Bill model's own comment block). The real per-item detail lives
// one hop away, on the Order's OrderLine rows (unitPriceMinor, quantity,
// modifiers), which is what a Bill's subtotal was actually computed from
// (bills.service.ts's computeSubtotal()). So CreditNoteLine itemizes against
// OrderLine, not against Bill - this is real line-level detail, not a
// simplification, because that's genuinely where Bill's numbers come from.
// A CreditNote with no lines client-supplied refunds every OrderLine's full
// remaining (not-yet-refunded) quantity - a whole-bill refund is just the
// same itemized mechanism applied to every line, not a separate code path.
// ---------------------------------------------------------------------------

model CreditNote {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  originalBillId     String   @map("original_bill_id") @db.Uuid
  reason             String
  // The manager who approved this refund (platform/manager-auth's
  // ManagerApproval.approverId) - distinct from createdByStaffId below, same
  // actor/approver split Bill already draws between createdByStaffId and
  // finalizedByStaffId.
  approvedByStaffId  String   @map("approved_by_staff_id") @db.Uuid
  createdByStaffId   String   @map("created_by_staff_id") @db.Uuid
  // Sum of this note's lines' amountMinor, and that subtotal's tax reversed
  // at the same TAX_RATE_PLACEHOLDER_PERCENT the original bill's tax was
  // computed with (bills.service.ts) - never re-derived or re-guessed.
  // totalMinor (subtotal + tax) is derived in CreditNoteView, same
  // never-persisted-derived-total convention as BillView.totalMinor.
  subtotalMinor      BigInt   @map("subtotal_minor")
  taxMinor           BigInt   @map("tax_minor")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  originalBill    Bill             @relation(fields: [originalBillId], references: [id])
  approvedByStaff StaffUser        @relation("CreditNoteApprovedBy", fields: [approvedByStaffId], references: [id])
  createdByStaff  StaffUser        @relation("CreditNoteCreatedBy", fields: [createdByStaffId], references: [id])
  lines           CreditNoteLine[]

  @@index([tenantId])
  @@index([originalBillId])
  @@map("credit_notes")
}

// One row per refunded OrderLine, quantity and amount reversed - unitPriceMinor
// is copied from that OrderLine's own unitPriceMinor plus its modifiers'
// priceMinor total (the same per-unit figure computeSubtotal() folds into a
// Bill's subtotal), snapshotted here so a later price change never
// retroactively alters an already-issued credit note (same insert-only-
// snapshot posture as OrderLine.unitPriceMinor itself).
model CreditNoteLine {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  creditNoteId   String @map("credit_note_id") @db.Uuid
  orderLineId    String @map("order_line_id") @db.Uuid
  quantity       Int
  unitPriceMinor BigInt @map("unit_price_minor")
  amountMinor    BigInt @map("amount_minor")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  orderLine  OrderLine  @relation(fields: [orderLineId], references: [id])

  @@index([tenantId])
  @@index([creditNoteId])
  @@index([orderLineId])
  @@map("credit_note_lines")
}

// ---------------------------------------------------------------------------
// pos/CAP-6 QSR counter and token mode (AD-14, story 7). Same reserve-then-
// commit discipline as BillNumberCounter above - one row per outlet,
// incremented by a real UPDATE inside the SAME transaction that creates the
// counter Order, never a Postgres SEQUENCE (whose nextval() would not roll
// back with an aborted creation attempt, leaving a real gap). A separate
// table from BillNumberCounter rather than a second column on it: the two
// sequences are reserved at different moments (token at Order creation,
// bill number at Bill finalise) by different services, and an outlet's
// counter-order count and bill count diverge from the very first order.
model TokenNumberCounter {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  outletId   String @unique @map("outlet_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])

  @@map("token_number_counters")
}
