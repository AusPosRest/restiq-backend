generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Prisma 7 emits ESM by default; Nest 11 is CJS. Revisit at Nest 12's ESM release.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Control-plane tables only (AD-1): operator identity and the control-plane
// audit trail. Tenant-owned tables (all carrying tenant_id + RLS, AD-5) arrive
// with the stories that need them.

model OperatorUser {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("operator_users")
}

// Append-only (AD-6, AD-8): rows are inserted, never updated or deleted.
model ControlPlaneAuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  action     String
  reason     String?
  // Dual timestamps: when it happened per the app, when the row landed.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("control_plane_audit_events")
}

// The registry owns existence, not state (AD-9): tenant id, region pointer,
// lifecycle - nothing else. Business state lives in the region tenant row.
model TenantRegistryEntry {
  tenantId  String          @id @map("tenant_id") @db.Uuid
  region    String
  lifecycle TenantLifecycle
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_registry")
}

enum TenantLifecycle {
  provisioning
  active
  deleted
}

// An operator's in-flight onboarding wizard. A draft is not a tenant: it is
// control-plane working state, one per operator, deleted on successful submit.
model OnboardingDraft {
  id         String   @id @default(uuid(7)) @db.Uuid
  operatorId String   @unique @map("operator_id") @db.Uuid
  steps      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("onboarding_drafts")
}

// AD-7: the idempotent replay ledger. Lives in the control plane (no
// tenant_id) - a client op_id lands here once, and a replay of an applied op
// is a ledger hit, never a second effect. Story 7 (DLQ replay) is its main
// consumer; created now because AD-7 binds CAP-4 too.
model AppliedOp {
  opId      String   @id @map("op_id") @db.Uuid
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("applied_ops")
}

// ---------------------------------------------------------------------------
// Region-plane tables (v1: the single Mumbai plane shares this database).
// Every tenant-owned table carries tenant_id with forced RLS (AD-5) - the
// policies live in the migration SQL. `tenants.id` IS the tenant_id.
// ---------------------------------------------------------------------------

enum TenantStatus {
  provisioning
  active
}

enum Country {
  IN
  AU
}

enum SubscriptionPlan {
  standard
  enterprise
}

enum BillingPeriod {
  monthly
  annual
}

model Tenant {
  id                String           @id @db.Uuid
  name              String
  registeredAddress String           @map("registered_address")
  contactName       String           @map("contact_name")
  contactEmail      String           @map("contact_email")
  contactPhone      String           @map("contact_phone")
  country           Country
  status            TenantStatus     @default(provisioning)
  // Subscription business state is region-side per AD-9; a later story
  // normalizes it into per-outlet subscriptions.
  plan              SubscriptionPlan
  billingPeriod     BillingPeriod    @map("billing_period")
  // Flat map of design-token overrides (logo URL, accent color, ...) applied
  // to the tenant's guest-facing surfaces.
  brandingTokens    Json             @default("{}") @map("branding_tokens")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  taxRegistrations TenantTaxRegistration[]
  brands           Brand[]
  outlets          Outlet[]
  roles            Role[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  itemVariants     ItemVariant[]
  itemPrices       ItemPrice[]
  modifierGroups   ModifierGroup[]
  modifiers        Modifier[]
  itemModifierGroups ItemModifierGroup[]
  allergens        Allergen[]
  itemAllergens    ItemAllergen[]
  combos           Combo[]
  comboComponents  ComboComponent[]
  itemOutletOverrides ItemOutletOverride[]
  menuImportDrafts MenuImportDraft[]
  ownerInvites     OwnerInvite[]
  ownerUsers       OwnerUser[]
  capabilities     TenantCapability[]
  devices          Device[]
  enrolmentCodes   EnrolmentCode[]
  deadLetters      SyncDeadLetter[]
  subscription     Subscription?
  invoices         Invoice[]
  checklistProgress ChecklistProgress?

  // The directory list is served from these: filter columns plus the
  // created_at ordering the default sort and cursor walk.
  @@index([createdAt])
  @@index([status])
  @@index([country])
  @@map("tenants")
}

// Tenant-level feature switches operated from the console. Absent row = the
// platform default for that key; a row records an explicit operator choice.
model TenantCapability {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_capabilities")
}

enum TaxRegistrationType {
  gstin
  abn
}

model TenantTaxRegistration {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  registrationType   TaxRegistrationType @map("registration_type")
  // One legal entity, one tenant per region - also the forced-failure anchor
  // for the atomicity tests.
  registrationNumber String              @unique @map("registration_number")
  legalEntityName    String              @map("legal_entity_name")
  taxProfile         String              @map("tax_profile")
  fssaiLicense       String?             @map("fssai_license")
  compositionScheme  Boolean             @default(false) @map("composition_scheme")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_tax_registrations")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  outlets Outlet[]

  @@map("brands")
}

enum OutletType {
  dine_in
  qsr
  cloud_kitchen
  food_court
}

model Outlet {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  brandId   String     @map("brand_id") @db.Uuid
  name      String
  address   String
  type      OutletType
  timezone  String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  brand          Brand           @relation(fields: [brandId], references: [id])
  devices        Device[]
  enrolmentCodes EnrolmentCode[]
  itemPrices          ItemPrice[]
  itemOutletOverrides ItemOutletOverride[]

  @@index([tenantId])
  @@map("outlets")
}

model Role {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  isSystem Boolean @default(false) @map("is_system")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("roles")
}

model MenuCategory {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int    @map("sort_order")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  items  MenuItem[]
  combos Combo[]

  @@map("menu_categories")
}

// AD-11: price lives in item_prices, not here - this table never carries a
// price column so no future writer is tempted to UPDATE one in place.
model MenuItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String
  // Short label for kitchen order tickets (PRD FR-10).
  shortName  String   @map("short_name")
  // The 86 toggle (CAP-4): tenant-wide, immediate, not versioned - price
  // history is the only thing AD-11 requires append-only, not availability.
  available  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  category       MenuCategory         @relation(fields: [categoryId], references: [id])
  variants       ItemVariant[]
  prices         ItemPrice[]
  modifierGroups ItemModifierGroup[]
  allergens      ItemAllergen[]
  comboComponents ComboComponent[]
  outletOverrides ItemOutletOverride[]

  // No two items in the same category may share a name (also the natural
  // forced-failure anchor for the menu-import commit atomicity test).
  @@unique([tenantId, categoryId, name])
  @@map("menu_items")
}

// CAP-4: e.g. Half/Full. A price row with a null variantId prices the item
// itself; a price row with a variantId prices that specific variant - the two
// never mix for the same item once variants exist (enforced at write time).
model ItemVariant {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  name      String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  item   MenuItem    @relation(fields: [itemId], references: [id])
  prices ItemPrice[]

  @@unique([itemId, name])
  @@map("item_variants")
}

enum PriceChannel {
  dine_in
  takeaway
  delivery
  qr
  aggregator
}

// AD-11: insert-only, extended by this story (story 2 created it) with the
// dimensions CAP-4 needs. A price change is always a new row - nothing ever
// UPDATEs price_minor. variantId/channel/outletId are each nullable and each
// null means "unscoped on this dimension" (variant: prices the base item;
// channel: applies to every channel; outlet: applies tenant-wide) - the
// current-price read (menu/pricing.ts) picks the most specific match. See
// menu/pricing.ts for the resolution query this shape exists to serve.
model ItemPrice {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  itemId      String        @map("item_id") @db.Uuid
  variantId   String?       @map("variant_id") @db.Uuid
  outletId    String?       @map("outlet_id") @db.Uuid
  channel     PriceChannel?
  // Money as bigint minor units (workspace convention).
  priceMinor  BigInt        @map("price_minor")
  currency    String        @db.Char(3)
  // Null/past = immediate; future = scheduled. Defaults to "now" so an
  // un-scheduled edit is immediately current without any special-casing in
  // the resolution query.
  effectiveAt DateTime      @default(now()) @map("effective_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  item    MenuItem     @relation(fields: [itemId], references: [id])
  variant ItemVariant? @relation(fields: [variantId], references: [id])
  outlet  Outlet?      @relation(fields: [outletId], references: [id])

  @@index([itemId, variantId, effectiveAt])
  @@map("item_prices")
}

// CAP-4 modifier groups (e.g. "Spice Level", "Add-ons") - tenant-scoped and
// reusable across items via item_modifier_groups. min/max are validated at
// write time (0 <= min <= max) in menu/modifier-groups.service.ts.
model ModifierGroup {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  minSelections Int      @map("min_selections")
  maxSelections Int      @map("max_selections")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  modifiers Modifier[]
  items     ItemModifierGroup[]

  @@unique([tenantId, name])
  @@map("modifier_groups")
}

// A modifier's price is a flat add-on, not versioned history (unlike item
// prices) - CAP-4's AD-11 obligation binds item_prices, not this table.
model Modifier {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  groupId    String @map("group_id") @db.Uuid
  name       String
  priceMinor BigInt @default(0) @map("price_minor")
  sortOrder  Int    @map("sort_order")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  group  ModifierGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, name])
  @@map("modifiers")
}

model ItemModifierGroup {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sortOrder Int    @map("sort_order")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  item   MenuItem      @relation(fields: [itemId], references: [id])
  group  ModifierGroup @relation(fields: [groupId], references: [id])

  @@unique([itemId, groupId])
  @@map("item_modifier_groups")
}

// CAP-4 allergen/dietary tags - moved here from CAP-3 menu import per the
// spec amendment (unreliable from OCR/CSV extraction). Tenant-scoped catalog
// + a join table so the same tag applies to many items.
model Allergen {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  items  ItemAllergen[]

  @@unique([tenantId, name])
  @@map("allergens")
}

model ItemAllergen {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  itemId     String @map("item_id") @db.Uuid
  allergenId String @map("allergen_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  item     MenuItem @relation(fields: [itemId], references: [id])
  allergen Allergen @relation(fields: [allergenId], references: [id])

  @@unique([itemId, allergenId])
  @@map("item_allergens")
}

// CAP-4 combos - a lightweight bundle of existing items at a flat bundle
// price. Not in scope for versioned/scheduled pricing (only item_prices
// carries that AD-11 obligation); a combo price is edited in place like any
// other routine content field.
model Combo {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  name       String
  priceMinor BigInt   @map("price_minor")
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  category   MenuCategory?    @relation(fields: [categoryId], references: [id])
  components ComboComponent[]

  @@unique([tenantId, name])
  @@map("combos")
}

model ComboComponent {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  comboId  String @map("combo_id") @db.Uuid
  itemId   String @map("item_id") @db.Uuid
  quantity Int    @default(1)

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  combo  Combo    @relation(fields: [comboId], references: [id])
  item   MenuItem @relation(fields: [itemId], references: [id])

  @@unique([comboId, itemId])
  @@map("combo_components")
}

// CAP-4 per-outlet availability override - price's per-outlet dimension
// already lives on item_prices.outletId (one insert-only price path, AD-11),
// so this table carries only availability, which is mutable by design (86 is
// immediate, not versioned). No row = the item's tenant-wide `available`
// applies at that outlet.
model ItemOutletOverride {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  available Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  item   MenuItem @relation(fields: [itemId], references: [id])
  outlet Outlet   @relation(fields: [outletId], references: [id])

  @@unique([itemId, outletId])
  @@map("item_outlet_overrides")
}

enum MenuImportStatus {
  draft
  committed
}

// CAP-3: server-held draft between upload and commit (AD-6) - a real row, not
// per-instance memory, so it survives a reload and works across instances.
// `payload` holds the extracted items (name, shortName, category, price,
// per-field confidence); PATCH edits payload in place; commit copies the
// (possibly edited) payload into real catalogue rows, then marks this row
// resolved rather than deleting it, leaving a record of what was imported.
model MenuImportDraft {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  status      MenuImportStatus @default(draft)
  sourceType  String           @map("source_type")
  fileName    String           @map("file_name")
  payload     Json
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  committedAt DateTime?        @map("committed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("menu_import_drafts")
}

model OwnerInvite {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  // Only the hash is stored; the raw token is delivered out of band when the
  // invite email ships (Tenant Admin story).
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  // Distinct from expiry (CAP-1: expired vs. already-used are different
  // rejections) - set once, on the accept that consumes the token.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("owner_invites")
}

// The admin realm's principal (AD-10): one tenant owner account, created on
// invite acceptance. A separate model from OperatorUser by design (AD-3's
// disjoint-realm rule extends to AD-10) - no shared identity table.
model OwnerUser {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@map("owner_users")
}

// CAP-2 go-live checklist: one row per tenant, a completion timestamp per
// step or null for not-yet-done. Stories 2, 5, 6, 7 each own one column and
// call PATCH /admin/v1/checklist/:step when their feature completes it -
// this table does not derive any step from other tables today.
model ChecklistProgress {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  outletDetailsAt DateTime? @map("outlet_details_at") @db.Timestamptz(6)
  floorPlanAt     DateTime? @map("floor_plan_at") @db.Timestamptz(6)
  menuImportAt    DateTime? @map("menu_import_at") @db.Timestamptz(6)
  devicesAt       DateTime? @map("devices_at") @db.Timestamptz(6)
  staffAt         DateTime? @map("staff_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("checklist_progress")
}

// Region-plane audit trail (AD-8): tenant-affecting mutations audit here, in
// the same transaction as the mutation (AD-6). Append-only - the RLS policies
// in the migration grant INSERT and SELECT only.
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  action     String
  reason     String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// CAP-4 device fleet and enrolment (AD-6, AD-7).
// ---------------------------------------------------------------------------

enum DeviceType {
  pos
  kds
  kiosk
  cds
}

enum DeviceRole {
  terminal
  hub
}

enum DeviceStatus {
  active
  revoked
}

model Device {
  id                     String       @id @default(uuid(7)) @db.Uuid
  tenantId               String       @map("tenant_id") @db.Uuid
  outletId               String?      @map("outlet_id") @db.Uuid
  label                  String
  type                   DeviceType
  role                   DeviceRole   @default(terminal)
  status                 DeviceStatus @default(active)
  hardwareKeyFingerprint String       @map("hardware_key_fingerprint")
  enrolledAt             DateTime     @map("enrolled_at") @db.Timestamptz(6)
  revokedAt              DateTime?    @map("revoked_at") @db.Timestamptz(6)

  // CAP-6 sync health: latest-heartbeat snapshot, not an event log (NFR-15 -
  // metadata only, there is no payload field to begin with). A device that
  // has never sent a heartbeat has lastContactAt = null; the read side falls
  // back to enrolledAt so a device silent since enrolment still classifies.
  lastContactAt        DateTime? @map("last_contact_at") @db.Timestamptz(6)
  outboxDepth          Int?      @map("outbox_depth")
  appVersion           String?   @map("app_version")
  clockSkewSeconds     Int?      @map("clock_skew_seconds")
  recentRejectionCount Int?      @map("recent_rejection_count")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  outlet      Outlet?          @relation(fields: [outletId], references: [id])
  deadLetters SyncDeadLetter[]

  @@index([tenantId])
  @@index([outletId])
  @@map("devices")
}

// A one-time enrolment ticket (CAP-4): 15-minute TTL, consumed exactly once.
// Only the hash is stored - the raw code is returned once, at generation.
model EnrolmentCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  outletId   String     @map("outlet_id") @db.Uuid
  codeHash   String     @unique @map("code_hash")
  deviceType DeviceType @map("device_type")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?  @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])

  @@index([tenantId])
  @@map("enrolment_codes")
}

// AD-7's never-drop rejection sink - the single table CAP-4 and (later) CAP-7
// both consume. No payload bodies (NFR-15): payloadMeta is metadata only.
model SyncDeadLetter {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  opId        String    @map("op_id") @db.Uuid
  reasonCode  String    @map("reason_code")
  reasonText  String    @map("reason_text")
  payloadMeta Json      @default("{}") @map("payload_meta")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([tenantId])
  @@index([deviceId])
  @@map("sync_dead_letters")
}

// ---------------------------------------------------------------------------
// CAP-5 subscription operations (AD-6, AD-9). Plan and billing period stay on
// Tenant (already there); this table adds the state a subscription actually
// transitions through. AD-9: suspension lives here, in the region plane -
// never duplicated into the control-plane registry.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  active
  arrears
  suspended
}

model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  suspendedAt        DateTime?          @map("suspended_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  invoices Invoice[]

  @@map("subscriptions")
}

enum InvoiceStatus {
  paid
  pending
  overdue
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  period         String
  amountMinor    BigInt        @map("amount_minor_units")
  status         InvoiceStatus @default(pending)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@map("invoices")
}
