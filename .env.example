# Copy to .env and fill in. Never committed.
# What each of these is for: restiq-design/setup/01-dev-environment.md

# 8180 on the dev box; tradeservice holds 8080 there. Fly sets its own.
PORT=8180

# The site allowed to call this API. Required - the app refuses to start without it.
WEB_ORIGIN=https://restiqdev.idelta.com.au

# What the RUNNING APP connects with. Local Postgres in dev, Neon in prod - on
# Neon this is the POOLED string (the host with -pooler in it).
DATABASE_URL=postgresql://restiq:PASSWORD@localhost:5432/restiq_dev

# What the PRISMA CLI connects with - migrate, generate, studio. Leave it
# UNSET locally: there is one unpooled Postgres and prisma.config.ts falls
# back to DATABASE_URL when this is empty. On Neon this is the DIRECT string
# (no -pooler) - see restiq-design/setup/04-prisma-setup.md.
# DIRECT_URL=postgresql://restiq:PASSWORD@HOST/DB?sslmode=require&connect_timeout=15

# Wiped between test runs by the e2e suite - must never point at dev data.
TEST_DATABASE_URL=postgresql://restiq:PASSWORD@localhost:5432/restiq_test

# Signs operator (aud "ops") JWTs. Distinct from any future tenant signing
# secret by design (AD-3) - never reuse one value for both realms.
OPS_JWT_SECRET=generate-a-long-random-string

# Signs tenant owner (aud "admin") JWTs - the third disjoint realm (AD-10).
# Distinct from OPS_JWT_SECRET and any future tenant/guest secret.
ADMIN_JWT_SECRET=generate-a-different-long-random-string

# Signs pos staff (aud "pos") JWTs, and the short-lived outlet-selection
# handoff token (aud "pos-pending") - the fourth disjoint realm (AD-13).
# Distinct from OPS_JWT_SECRET and ADMIN_JWT_SECRET.
POS_JWT_SECRET=generate-yet-another-long-random-string

# Read only by `pnpm run seed:operator` - the first operator account.
# OPERATOR_EMAIL=you@restiq.example
# OPERATOR_PASSWORD=

# Hours a suspended tenant's POS keeps trading before the grace window
# expires (CAP-5). Business decision, not a hardcoded policy - read fresh on
# every subscription request.
# SUSPENSION_GRACE_HOURS=72
