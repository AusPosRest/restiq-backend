{
  "name": "restiq-backend",
  "version": "0.1.0",
  "description": "Restiq API",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "tsx scripts/migrate-test-db.ts && vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed:operator": "tsx scripts/seed-operator.ts",
    "seed:sync-health": "tsx scripts/seed-sync-health.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AusPosRest/restiq-backend.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AusPosRest/restiq-backend/issues"
  },
  "homepage": "https://github.com/AusPosRest/restiq-backend#readme",
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.8.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
