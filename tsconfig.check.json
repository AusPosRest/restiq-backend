// Typecheck EVERYTHING, including the config file tsconfig.json deliberately
// leaves out of the build: prisma.config.ts at the repo root.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // nothing is emitted here, so the build's src-only rootDir does not apply
    "rootDir": "."
  },
  "include": ["src", "prisma.config.ts"]
}
